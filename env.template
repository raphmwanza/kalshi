# =============================================================================
# Copy this file to .env and fill in real values:
#   copy env.template .env
# Never commit .env. Docker Compose reads it automatically.
# =============================================================================

# --- Kalshi API ---
# Key ID from https://kalshi.com/account/settings (API Keys)
KALSHI_API_KEY=your_kalshi_api_key_here

# Path to the RSA private key PEM downloaded from Kalshi.
# Default matches the file Docker mounts at /app/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Optional: paste the full PEM instead of mounting a file.
# If set, this takes priority over KALSHI_PRIVATE_KEY_PATH.
# Real newlines, Windows CRLF, a surrounding pair of quotes, and the
# two-character sequence \n are all accepted (Railway's env UI uses \n).
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Kalshi API base URL (optional). Leave unset for the default.
#   https://api.elections.kalshi.com   (default)
#   https://external-api.kalshi.com
# KALSHI_BASE_URL=https://external-api.kalshi.com

# --- OpenRouter (AI directional strategy only; tennis mode does not need this) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Bot process (docker-entrypoint.sh / docker compose) ---
# tennis | safe-compounder | directional
BOT_STRATEGY=tennis
# true = real orders (--live). false = dry run.
BOT_LIVE=true
# true = keep looping until the container stops
BOT_LOOP=true
# Seconds between tennis / safe-compounder cycles.
# Fractions and 0 are allowed (0.5, 0). A 1 second minimum still applies,
# and errors, HTTP 429s, and SofaScore blocks back off exponentially up to 60s.
BOT_INTERVAL=30
# How often an idle worker re-reads positions, resting orders, balance, and
# today's win rate. Between syncs, a cycle with no actionable score and no
# open tennis position does not call Kalshi. Default 60 seconds.
# KALSHI_SYNC_SECONDS=60
# Resting cash-out price. Default 0.94. A leftover 99c line is replaced on sync.
# SELL_ALL_AT=0.94
# Rounds that must not be entered. Default is semifinal and above
# (semifinals, finals, and championship matches). none turns the filter off.
# Quarterfinals are not included. Unknown rounds are logged and still traded.
SKIP_ROUNDS=semifinal,final
# Optional HTTP proxy for SofaScore only. Flashscore is tried first, then ESPN.
# SOFASCORE_PROXY_URL=http://user:pass@host:port
# Public Flashscore feed sign header. Override only if the site rotates it.
# FLASHSCORE_FSIGN=SW9D1eZo

# --- Trading / logging ---
# Used by the AI directional path. Tennis honors BOT_LIVE instead.
LIVE_TRADING_ENABLED=false
LOG_LEVEL=INFO
# File logs are optional. stdout is always on, which is what Railway collects.
# Set this to false on Railway so the container does not fill its disk.
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# --- Dashboard service (second Railway service, not the worker) ---
# BOT_MODE=dashboard
# DASHBOARD_PASSWORD=choose-a-long-password
# Session cookie is Secure, HttpOnly, and SameSite=Strict. Login is rate-limited.
# Local HTTP only: DASHBOARD_COOKIE_SECURE=false
# Public origin, if Host behind the proxy is not the browser origin:
# DASHBOARD_PUBLIC_URL=https://your-dashboard.up.railway.app
# PORT is set by Railway. The server listens on 0.0.0.0:$PORT.
#
# Accounts pasted in the dashboard are encrypted in Postgres. The same Fernet
# key must be set on the dashboard service and the worker. Key storage refuses
# to start when this is missing. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEYS_ENCRYPTION_KEY=
# Stored accounts default to dry run. They trade live only when the account
# toggle is Live and BOT_LIVE=true. The worker reloads them every cycle.

# --- Database / tennis journal ---
# Postgres (Railway): attach a Postgres plugin and leave DATABASE_URL as Railway sets it.
# SQLite: a sqlite URL, or unset DATABASE_URL (file tennis_journal.db).
# JSONL instead of a database: TRADE_LOG_BACKEND=jsonl and TRADE_LOG_PATH=tennis_journal.jsonl
DATABASE_URL=sqlite:///trading_system.db
# TRADE_LOG_BACKEND=sqlite
# TRADE_LOG_PATH=tennis_journal.db

# --- Several Kalshi accounts (optional) ---
# One process can trade every account. SofaScore is fetched once per cycle.
# JSON list takes priority. private_key is a PEM (real newlines or \n).
# KALSHI_ACCOUNTS=[{"name":"main","api_key_id":"...","private_key":"<PEM body, use \\n between lines>"}]
# Or numbered vars (stop at the first gap). The single KALSHI_API_KEY above is the fallback.
# KALSHI_ACCOUNT_NAME_1=main
# KALSHI_API_KEY_ID_1=
# KALSHI_PRIVATE_KEY_1=
# KALSHI_ACCOUNT_NAME_2=backup
# KALSHI_API_KEY_ID_2=
# KALSHI_PRIVATE_KEY_2=

# --- Performance monitoring ---
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15

# Daily LLM spend cap in USD (AI directional strategy)
# DAILY_AI_COST_LIMIT=10.0
