# =============================================================================
# Copy this file to .env and fill in real values:
#   copy env.template .env
# Never commit .env. Docker Compose reads it automatically.
# =============================================================================

# --- Kalshi API ---
# Key ID from https://kalshi.com/account/settings (API Keys)
KALSHI_API_KEY=your_kalshi_api_key_here

# Path to the RSA private key PEM downloaded from Kalshi.
# Default matches the file Docker mounts at /app/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Optional: paste the full PEM instead of mounting a file (use \n for newlines).
# If set, this takes priority over KALSHI_PRIVATE_KEY_PATH.
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Kalshi API base URL (optional). Leave unset for the default.
#   https://api.elections.kalshi.com   (default)
#   https://external-api.kalshi.com
# KALSHI_BASE_URL=https://external-api.kalshi.com

# --- OpenRouter (AI directional strategy only; tennis mode does not need this) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Bot process (docker-entrypoint.sh / docker compose) ---
# tennis | safe-compounder | directional
BOT_STRATEGY=tennis
# true = real orders (--live). false = dry run.
BOT_LIVE=true
# true = keep looping until the container stops
BOT_LOOP=true
# Seconds between tennis / safe-compounder cycles
BOT_INTERVAL=30

# --- Trading / logging ---
# Used by the AI directional path. Tennis honors BOT_LIVE instead.
LIVE_TRADING_ENABLED=false
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# --- Database ---
DATABASE_URL=sqlite:///trading_system.db

# --- Performance monitoring ---
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15

# Daily LLM spend cap in USD (AI directional strategy)
# DAILY_AI_COST_LIMIT=10.0
